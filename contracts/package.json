{
  "name": "proofchain-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solidity contracts for ProofChain. Kept as a separate package so the Hardhat toolchain never enters the web application's dependency tree.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:baseSepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "export-abi": "hardhat run scripts/export-abi.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.0.0",
    "hardhat": "^3.16.0",
    "typescript": "^5",
    "viem": "^2.56.3"
  }
}
