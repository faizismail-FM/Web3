# ---------------------------------------------------------------------------
# ProofChain environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://proofchain:proofchain@localhost:5432/proofchain?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment (used for callbacks and verification links).
NEXTAUTH_URL="http://localhost:3000"

# Public base URL embedded in verification links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------

# `mock`  — simulate registrations locally; no wallet or RPC required.
# `real`  — anchor proofs on the configured Base Sepolia contract.
BLOCKCHAIN_MODE="mock"
NEXT_PUBLIC_BLOCKCHAIN_MODE="mock"

# JSON-RPC endpoint for Base Sepolia (only required when BLOCKCHAIN_MODE=real).
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Deployed ProofChainRegistry address (only required when BLOCKCHAIN_MODE=real).
CONTRACT_ADDRESS=""
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# Private key used ONLY by the contract deployment script.
# It is never read by the Next.js application and must never be exposed to the
# browser. Leave empty unless you are deploying the contract.
DEPLOYER_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory where uploaded documents are stored off-chain.
STORAGE_DIR="./storage"

# Maximum accepted upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES="10485760"
